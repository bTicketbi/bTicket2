<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Thème de l'application une fois le démarrage terminé -->
    <style name="Theme.BTicket" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Écran de démarrage natif : fond uni, sans icône (l'animation du logo prend le relais) -->
    <style name="Theme.BTicket.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.BTicket</item>
    </style>
</resources>
